# Copy to .env and generate a unique secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_API_URL=https://api.classpulse.info/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.classpulse.info
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# For deployment, set NEXTAUTH_URL=https://admin.classpulse.info
# and use a separate, private NEXTAUTH_SECRET in the hosting environment.
